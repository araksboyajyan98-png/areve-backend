generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  /// Рабочее подключение — через пул Neon. Приложение ходит только сюда:
  /// пул держит соединения за нас и переживает всплески запросов.
  url = env("DATABASE_URL")

  /// Миграции — в обход пула, напрямую. Через пул они не проходят:
  /// блокировки и команды изменения структуры требуют одного и того же
  /// соединения от начала до конца, а пул этого не гарантирует.
  directUrl = env("DIRECT_URL")
}

/// Заявка из формы обратной связи на лендинге.
/// Одна запись — одно обращение, а не один ребёнок и не один договор.
model Lead {
  id String @id @default(uuid())

  /// Имя родителя, как он его написал.
  name String @db.VarChar(100)

  /// Телефон в виде +374XXXXXXXX — приводит сервис при создании.
  phone String @db.VarChar(32)

  /// Вопрос или желаемый день визита. В форме поле необязательное.
  message String? @db.VarChar(2000)

  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // список «сначала новые»
  @@index([createdAt])
  // список необработанных
  @@index([status, createdAt])
}

enum LeadStatus {
  NEW /// поступила, никто не смотрел
  CONTACTED /// с родителем связались
  ARCHIVED /// закрыта: пришли, отказались или дубль
}
