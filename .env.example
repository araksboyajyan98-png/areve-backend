# Скопируйте в .env и заполните. Сам .env в git не попадает.

PORT=5001
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug

# База — Neon (облачный PostgreSQL 16, регион Frankfurt).
# Строки две, но база одна и та же:
#   DATABASE_URL — через пул, в адресе есть «-pooler». Им пользуется сайт.
#   DIRECT_URL   — напрямую, без пула. Только для миграций: они требуют
#                  одного соединения от начала до конца, а пул этого
#                  не обещает, и «prisma migrate» через него зависает.
# Обе берутся в панели Neon: кнопка Connect, переключатель Pooled connection.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/areve?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/areve?sslmode=require"

# Разрешённые origin фронтенда через запятую
CORS_ORIGINS=http://localhost:5173

# Сколько заявок принимаем с одного адреса и за какое окно.
# Форма открыта всему интернету, авторизации нет — это единственная преграда.
LEADS_RATE_LIMIT_MAX=10
LEADS_RATE_LIMIT_WINDOW_MINUTES=60

# За обратным прокси (nginx, облачный хостинг) — сколько ему доверять.
# Пусто = не доверять никому: req.ip берётся из сокета.
# За одним прокси ставьте 1, иначе все заявки придут с одного адреса
# и ограничение частоты отсечёт настоящих родителей.
TRUST_PROXY=

# ── Уведомление о новой заявке ────────────────────────────────
# Куда приходит письмо о заявке — рабочий Gmail центра.
LEADS_NOTIFY_TO=

# SMTP. Для Gmail: host smtp.gmail.com, port 587, user — сам адрес,
# password — НЕ пароль от почты, а «пароль приложения»:
# он создаётся в настройках аккаунта Google и требует включённой
# двухэтапной проверки. Обычный пароль Gmail по SMTP не пустит.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Адрес в поле «От кого». Пусто — возьмётся SMTP_USER.
SMTP_FROM=

# Пока эти переменные пустые, заявки всё равно сохраняются —
# не уходит только уведомление, и это видно в логе.
